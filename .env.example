# Home Assistant credentials (server only — never add these to the mobile app)
HA_URL=http://home-assistant.local:8123
HA_TOKEN=replace-with-a-long-lived-access-token

# AI and speech services (server only)
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=typhoon
GEMINI_API_KEY=replace-with-your-key
# Set AI_PROVIDER=typhoon to use Typhoon instead of Gemini.
TYPHOON_API_KEY=
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
# Optional USD per million tokens; leave blank when pricing is unknown.
TYPHOON_PRICE_INPUT_PER_M=
TYPHOON_PRICE_OUTPUT_PER_M=
GROQ_API_KEY=replace-with-your-key
TAPO_EMAIL=you@example.com
TAPO_PASSWORD=replace-with-your-password

# Synapse API network configuration
API_PORT=4000
# Thai public holidays (server only). Obtain a key from calendarific.com.
CALENDARIFIC_API_KEY=
# Comma-separated browser origins. Native apps have no Origin header.
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.10:3000
